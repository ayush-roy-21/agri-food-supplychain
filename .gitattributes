# ──────────────────────────────────────────────
# Line ending normalization
# ──────────────────────────────────────────────
* text=auto

# ──────────────────────────────────────────────
# Source code — always LF
# ──────────────────────────────────────────────
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.txt text eol=lf
*.sh text eol=lf

# ──────────────────────────────────────────────
# Data files — treat as text, diff-friendly
# ──────────────────────────────────────────────
*.csv text eol=lf diff
*.tsv text eol=lf diff

# ──────────────────────────────────────────────
# Binary files — no merge, no diff
# ──────────────────────────────────────────────
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.pdf binary
*.xlsx binary
*.xls binary
*.zip binary
*.gz binary
*.tar binary
